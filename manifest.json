{
  "manifest_version": 3,
  "name": "Full Page Downloader (HTML+Assets ZIP)",
  "version": "6.0.0",
  "description": "دانلود کامل هر صفحه وب به همراه تمام فایل‌های وابسته (CSS، JS، تصاویر، فونت‌ها) در قالب فایل ZIP یا MHTML با قابلیت خزش چند صفحه‌ای، دانلود موازی، مدیریت صف، فیلتر پیشرفته، محدودیت سرعت، و تم تاریک/روشن",
  "permissions": ["activeTab", "scripting", "downloads", "notifications", "storage", "tabs", "cookies", "debugger"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "دانلود کامل صفحه به صورت ZIP"
  },
  "commands": {
    "open-popup": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "باز کردن پاپ‌آپ دانلود"
    },
    "quick-download": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "دانلود سریع با تنظیمات پیش‌فرض"
    },
    "toggle-theme": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "تغییر تم تاریک/روشن"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
